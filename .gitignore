# =============================================================================
outputs/*.png
outputs/*.jpg
outputs/*.jpeg
outputs/*.pdf
outputs/*.svg
outputs/*.html
outputs/*.json
# Manter .gitkeep
!outputs/.gitkeep

# Logs e métricas
logs/
runs/
wandb/
mlruns/
*.log
*.tsv

