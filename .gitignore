models/*.ckpt
models/*.h5
models/*.pkl
models/*.joblib
models/*.bin
# Manter .gitkeep para preservar a pasta
!models/.gitkeep

# =============================================================================
# Dados
# =============================================================================
# Dados brutos (grandes arquivos DICOM, imagens médicas)
data/raw/
data/processed/
data/interim/
data/external/
*.dcm
*.nii
*.nii.gz
*.mha
*.mhd

# CSVs clínicos do CBIS-DDSM são versionados (pequenos, importantes)
# Para ignorar CSVs grandes, descomente abaixo:
# *.csv
# *.xlsx

# =============================================================================
